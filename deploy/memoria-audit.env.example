# /etc/memoria/audit.env — read by memoria-audit.service, last, so it overrides the
# defaults in the unit. Owned by root, mode 0600: it may hold an API key.
#
# cp deploy/memoria-audit.env.example /etc/memoria/audit.env
# sudo chown root:root /etc/memoria/audit.env && sudo chmod 600 /etc/memoria/audit.env

# Where the real database lives. Without this the audit opens ./data/memoria.db
# inside the repo, which on a server is usually not what you want.
MEMORIA_DB_PATH=/home/exedev/memoria/data/memoria.db

# Judge: the 4B by default (10/10 recall in the sweep), on the on-demand unit.
MEMORIA_JUDGE_MODEL=qwen3-4b-instruct-2507
MEMORIA_JUDGE_BASE_URL=http://127.0.0.1:8085/v1
MEMORIA_JUDGE_FORMAT=letters
MEMORIA_JUDGE_NO_THINK=1
# For a remote judge instead: point the URL at it, set the key, and disable the
# local health check, which a hosted API does not expose.
# MEMORIA_JUDGE_BASE_URL=https://api.example.com/v1
# MEMORIA_JUDGE_API_KEY=sk-…
# MEMORIA_AUDIT_SKIP_HEALTH=1

# Embedder: the audit needs the same embedder the rows were written with, or
# similarity search finds nothing to judge.
MEMORIA_EMBED_PROVIDER=openai
MEMORIA_EMBED_BASE_URL=http://127.0.0.1:8083/v1
MEMORIA_EMBED_MODEL=nomic-embed-text-v1.5

# Ceilings. max-calls is per user per night; at 2.6 s a call, 40 calls ≈ 105 s.
MEMORIA_AUDIT_MAX_CALLS=40
MEMORIA_AUDIT_LIMIT=200
MEMORIA_AUDIT_REPORT_DIR=/home/exedev/memoria/data/audit
