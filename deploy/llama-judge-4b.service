# The bigger judge, on demand.
#
#   sudo systemctl start llama-judge-4b
#   MEMORIA_JUDGE_BASE_URL=http://127.0.0.1:8085/v1 \
#   MEMORIA_JUDGE_MODEL=qwen3-4b npm run contradictions -- --apply
#   sudo systemctl stop llama-judge-4b
#
# Not enabled at boot: 2.6 GB of RAM and ~2.6 s per judgement on two cores. Caught
# 10/10 contradictions in the sweep where the 1.7B caught 6/10, so it is the right
# model for a backfill and the wrong one for an interactive write.
[Unit]
Description=llama.cpp server (Memoria contradiction judge, 4B)
# Alternative to the audit managing its own judge: start this by hand for a long
# sweep and set MEMORIA_AUDIT_MANAGE_JUDGE=0. Unloaded by RuntimeMaxSec if forgotten.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exedev
ExecStart=/home/exedev/llm/llama.cpp/build/bin/llama-server \
  -m /home/exedev/llm/models/qwen3-4b-instruct-2507-q4_k_m.gguf \
  -c 4096 --host 127.0.0.1 --port 8085 -t 2 --jinja --no-webui
Restart=on-failure
# Backstop: even if the audit cannot stop this unit, it cannot sit in RAM forever.
RuntimeMaxSec=1800
RestartSec=3
OOMScoreAdjust=-150

[Install]
WantedBy=manual.target
