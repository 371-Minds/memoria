# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# One SQLite file. Relative paths resolve from the working directory.
MEMORIA_DB_PATH=./data/memoria.db

# f32 = exact (default, 4 bytes per dimension) | int8 = ~4x smaller, ~97% recall@5
MEMORIA_VECTOR_CODEC=f32

# ---------------------------------------------------------------------------
# Embeddings: pick the model you actually run. Nothing here is Gemini-specific.
# ---------------------------------------------------------------------------
# openai | tei | gemini | hash | none
#   openai = any OpenAI-compatible /v1/embeddings endpoint (OpenAI, Ollama,
#            vLLM, LM Studio, LocalAI, a gateway in front of them)
#   tei    = HuggingFace text-embeddings-inference native API
#   gemini = Google Generative Language API
#   hash   = offline lexical embeddings (no model, no network; dev and tests)
#   none   = keyword-only search
# Leave everything blank to get `hash`.
MEMORIA_EMBED_PROVIDER=openai
MEMORIA_EMBED_BASE_URL=https://api.openai.com/v1
MEMORIA_EMBED_API_KEY=
MEMORIA_EMBED_MODEL=text-embedding-3-small
# Optional: truncate to this many dimensions (Matryoshka). Must match the model's.
# MEMORIA_EMBED_DIM=768
# Extra headers, as JSON, for a gateway that wants its own routing headers.
# MEMORIA_EMBED_HEADERS={"x-my-gateway-key":"..."}
MEMORIA_EMBED_BATCH=32
MEMORIA_EMBED_TIMEOUT_MS=15000

# A local Ollama instead of a cloud provider:
# MEMORIA_EMBED_PROVIDER=openai
# MEMORIA_EMBED_BASE_URL=http://localhost:11434/v1
# MEMORIA_EMBED_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Write path
# ---------------------------------------------------------------------------
# Cosine above which a new memory supersedes an existing one instead of being
# stored beside it. 0 disables supersede (append-only); 1 disables it too.
MEMORIA_DEDUPE_THRESHOLD=0.95
# Cosine above which two memories are linked as graph neighbours.
MEMORIA_GRAPH_SIMILARITY=0.72
# 1 = refuse a write when the embedding endpoint fails (default: store text only)
MEMORIA_REQUIRE_EMBEDDINGS=0

# ---------------------------------------------------------------------------
# Contradiction pass (optional; runs only when MEMORIA_JUDGE_MODEL is set)
# ---------------------------------------------------------------------------
# A cheap model call per write that decides what a new fact does to its nearest
# neighbours: contradiction (supersede), duplicate (touch), refines, unrelated.
# Similarity cannot tell "lives in Brooklyn" from "moved to Queens"; this can.
MEMORIA_JUDGE_MODEL=
MEMORIA_JUDGE_BASE_URL=https://api.openai.com/v1
MEMORIA_JUDGE_API_KEY=
# Extra headers for a gateway, as JSON (e.g. one that routes by header)
# MEMORIA_JUDGE_HEADERS={"x-autojev-binding":"judge"}
MEMORIA_JUDGE_TIMEOUT_MS=12000
# Similarity floor for the candidates the judge is shown, and how many.
MEMORIA_CONTRADICTION_FLOOR=0.5
MEMORIA_JUDGE_MAX_CANDIDATES=4
# Judge imported rows too (off by default: 100 rows must not be 100 model calls)
MEMORIA_JUDGE_IMPORT=0

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# key=scope pairs, comma separated; scope is a userId or *
# e.g. MEMORIA_API_KEYS="k_client_a=client_a,k_admin=*"
MEMORIA_API_KEY=change_me
# MEMORIA_API_KEYS=
# Only for a deliberately open instance (dev has this behaviour by default).
# MEMORIA_ALLOW_ANON=1

# Where the MCP server finds the app
APP_URL=http://localhost:3000
